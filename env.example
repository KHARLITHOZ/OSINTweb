# ============================================
# OSINTng - Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a Git

# Django
DEBUG=True
SECRET_KEY=cambia-esto-por-una-key-segura-de-64-caracteres
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
# DB_HOST=localhost  ← desarrollo local sin Docker
# DB_HOST=db         ← dentro de Docker Compose
DB_ENGINE=django.db.backends.postgresql
DB_NAME=plataforma_osint
DB_USER=osintng
DB_PASSWORD=cambia-esta-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# APIs OSINT (opcional)
# HIBP_API_KEY=
# ANTHROPIC_API_KEY=
