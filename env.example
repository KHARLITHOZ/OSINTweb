# ══════════════════════════════════════════════════════════════════════════════
# OSINTng — Variables de entorno
# Copia como .env y completa. NUNCA subas .env a Git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=GENERA-UNA-KEY-SEGURA-con-python-secrets-token-hex-64
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=plataforma_osint
DB_USER=osintng
DB_PASSWORD=CAMBIA-ESTA-PASSWORD-AHORA
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── APIs OSINT (opcionales) ───────────────────────────────────────────────────
HIBP_API_KEY=
ANTHROPIC_API_KEY=

# ── Email (para allauth email verification) ───────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@osintng.local

# ── Proxies de confianza (IPs de tu Nginx / load balancer) ───────────────────
TRUSTED_PROXIES=172.0.0.0/8

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=5
GUNICORN_THREADS=2
GUNICORN_LOG_LEVEL=info

# ── CORS (producción) ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://tu-dominio.com
